---
// EmailSignup.astro — DynamoDB email capture via API Gateway
---

<section class="email-signup" aria-label="Newsletter signup">
  <div class="email-signup__inner">
    <h2 class="email-signup__heading">Get AI engineering news and the latest in AI</h2>
    <p class="email-signup__description">
      A practical email on AI engineering, new tools, workflow shifts, and the latest in AI. Free, no spam.
    </p>
    <form class="email-signup__form" id="email-signup-form">
      <input
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        aria-label="Email address"
        class="email-signup__input"
      />
      <button type="submit" class="email-signup__button">Subscribe</button>
    </form>
    <p class="email-signup__status" id="email-signup-status" aria-live="polite"></p>
  </div>
</section>

<style>
  .email-signup {
    margin: 2.5rem 0;
    padding: clamp(1.35rem, 3vw, 2.25rem);
    border: 1px solid color-mix(in oklch, var(--sl-color-accent) 22%, transparent);
    border-radius: 0.875rem;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--sl-color-accent) 16%, transparent), transparent 42%),
      var(--primer-surface-warm, var(--sl-color-bg));
    text-align: left;
  }

  .email-signup__inner {
    max-width: 42rem;
  }

  .email-signup__heading {
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 0.55rem;
    color: var(--primer-ink, var(--sl-color-text));
  }

  .email-signup__description {
    color: var(--primer-muted, var(--sl-color-gray-2));
    margin: 0 0 1.25rem;
    font-size: 0.98rem;
    max-width: 36rem;
  }

  .email-signup__form {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    max-width: 31rem;
  }

  .email-signup__input {
    flex: 1 1 14rem;
    min-height: 2.65rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--primer-rule, var(--sl-color-gray-5));
    border-radius: 0.375rem;
    background: color-mix(in oklch, var(--sl-color-bg) 92%, var(--sl-color-accent) 8%);
    color: var(--primer-ink, var(--sl-color-text));
    font-size: 0.95rem;
  }

  .email-signup__input::placeholder {
    color: var(--primer-muted, var(--sl-color-gray-3));
  }

  .email-signup__input:focus {
    outline: 2px solid var(--primer-focus, var(--sl-color-accent));
    outline-offset: 2px;
    border-color: transparent;
  }

  .email-signup__button {
    min-height: 2.65rem;
    padding: 0.65rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .email-signup__button:hover {
    opacity: 0.88;
  }

  .email-signup__button:focus-visible {
    outline: 2px solid var(--primer-focus, var(--sl-color-accent));
    outline-offset: 3px;
  }

  .email-signup__button:disabled {
    opacity: 0.52;
    cursor: not-allowed;
  }

  .email-signup__status {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    min-height: 1.2em;
  }

  .email-signup__status.success {
    color: oklch(55% 0.16 145);
  }

  .email-signup__status.error {
    color: oklch(60% 0.2 28);
  }
</style>

<script>
  const form = document.getElementById('email-signup-form') as HTMLFormElement;
  const status = document.getElementById('email-signup-status')!;
  const API_URL = 'https://3urfpr6eve.execute-api.us-east-1.amazonaws.com/subscribe';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    const email = new FormData(form).get('email') as string;

    btn.disabled = true;
    status.textContent = '';
    status.className = 'email-signup__status';

    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'ai-coding-primer' }),
      });

      if (res.ok) {
        status.textContent = "Thanks! You're on the list.";
        status.classList.add('success');
        form.reset();
      } else {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || `Server responded ${res.status}`);
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.classList.add('error');
    } finally {
      btn.disabled = false;
    }
  });
</script>
